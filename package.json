{
  "name": "umi-monorepo-microfrontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* run dev",
    "dev:rsbuild": "pnpm -r --parallel --filter ./apps/* run dev:rsbuild",
    "build": "pnpm -r --filter ./packages/* run build && pnpm -r --filter ./apps/* run build:rsbuild",
    "build:umi": "pnpm -r --filter ./apps/* run build",
    "lint": "pnpm -r --filter ./apps/* run lint",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint-plugin-react": "^7.37.2"
  }
}
